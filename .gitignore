/target/
# The npm package's build output: made by scripts/build-js.sh, published, not committed.
/bindings/js/pkg/
/bindings/js/node_modules/
/bindings/elixir/_build/
/bindings/elixir/deps/
/bindings/elixir/priv/native/
/bindings/elixir/doc/
/bindings/elixir/*.ez
/bindings/elixir/erl_crash.dump
.DS_Store
# Release-time files: the vendored Cargo workspace and the checksums of the
# precompiled binaries are written into the packages by the release workflow,
# never committed (their absence is what makes a checkout build from source).
/bindings/elixir/native/
/bindings/elixir/checksum-*.exs
/bindings/dart/native/
/bindings/dart/hook/checksums.json
/bindings/dart/.dart_tool/
/bindings/dart/pubspec.lock
/bindings/python/.venv/
/bindings/python/python/kicksdk/*.so
/bindings/python/python/kicksdk/*.pyd
__pycache__/
/examples/rust/target/
/examples/rust/Cargo.lock
/examples/dart/.dart_tool/
/examples/dart/pubspec.lock
